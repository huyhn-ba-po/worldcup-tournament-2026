# Sao chép file này thành .env rồi điền key thật (file .env đã được gitignore — không bị đẩy lên GitHub).
# cp .env.example .env

# Tự lấy tỉ số trận đã đá từ football-data.org
# Đăng ký free: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# (tuỳ chọn) mã giải, mặc định WC = FIFA World Cup
# FOOTBALL_DATA_COMP=WC

# (tuỳ chọn) Gemini — chỉ cần nếu muốn dự đoán AI live cho trận chưa có sẵn (knockout)
GEMINI_API_KEY=
